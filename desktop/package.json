{
  "name": "@leapview/desktop",
  "productName": "LeapView",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "bun run build && bun scripts/run-electron.mjs start",
    "test": "bun test ./src && node --test ../internal/app/testing/maliciousinstance/electron/policy.test.mjs",
    "package": "bun run build && bun scripts/run-electron.mjs package",
    "make": "bun run build && bun scripts/run-electron.mjs make"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@types/node": "24.13.3",
    "electron": "43.2.0",
    "node": "24.14.0",
    "rxjs": "7.8.2",
    "typescript": "5.9.3"
  },
  "trustedDependencies": [
    "electron",
    "node"
  ]
}
