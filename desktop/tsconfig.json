{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmitOnError": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "forge.config.ts",
    "src/**/*.ts",
    "src/security/**/*.mjs",
    "src/security/**/*.d.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
