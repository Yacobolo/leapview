[Unit]
Description=rtest REAPI and CAS (NativeLink)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=rtest
Group=rtest
SupplementaryGroups=docker
EnvironmentFile=/etc/rtest/standards.env
ExecStart=/usr/local/bin/nativelink /etc/rtest/nativelink.json5
Restart=on-failure
RestartSec=3
LimitNOFILE=24576
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rtest

[Install]
WantedBy=multi-user.target
