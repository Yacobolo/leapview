[Unit]
Description=rtest shared control plane and scoped data-plane gateways
After=network-online.target docker.service rtest-cas.service rtest-buildkit.service
Wants=network-online.target
Requires=docker.service rtest-cas.service rtest-buildkit.service

[Service]
User=rtest
Group=rtest
SupplementaryGroups=docker
EnvironmentFile=/etc/rtest/service.env
ExecStart=/usr/local/bin/rtest-server
Restart=always
RestartSec=2
TimeoutStopSec=30
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rtest
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
