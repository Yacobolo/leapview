[Unit]
Description=rtest Docker worker
After=docker.service rtest-server.service
Requires=docker.service rtest-server.service

[Service]
User=rtest
Group=rtest
SupplementaryGroups=docker
EnvironmentFile=/etc/rtest/rtest.env
Environment=RTEST_URL=http://127.0.0.1:8080
Environment=RTEST_WORK_ROOT=/var/lib/rtest/jobs
Environment=RTEST_CACHE_ROOT=/var/lib/rtest/cache
Environment=RTEST_RUNNER_IMAGE=rtest-runner-standard:local
ExecStart=/usr/local/bin/rtest-worker
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
