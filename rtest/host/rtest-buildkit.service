[Unit]
Description=rtest remote BuildKit
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=-/etc/rtest/standards.env
EnvironmentFile=-/etc/rtest/swarm.env
ExecStartPre=-/usr/bin/docker rm -f rtest-buildkit
ExecStart=/usr/bin/docker run --rm --name rtest-buildkit --privileged --network host --memory 3g --pids-limit 4096 -v rtest-buildkit-state:/var/lib/buildkit ${RTEST_BUILDKIT_IMAGE} --addr tcp://127.0.0.1:1234 --oci-worker-gc=true --oci-worker-gc-keepstorage=30000
ExecStop=/usr/bin/docker stop -t 20 rtest-buildkit
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
